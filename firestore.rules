rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // UltronChat is intentionally database-free for room state, messages, files,
    // presence, and signaling. Deny all access so a stale client cannot turn
    // ephemeral room content into a cloud archive.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
